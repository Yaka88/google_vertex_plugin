{
  "name": "@magpie-community/gcp-ai",
  "version": "0.1.0",
  "description": "Vertex AI models and Google Cloud promotional credits, signed with your own gcloud / ADC login",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "lib/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.mjs && node --check lib/browser.mjs && node --check lib/credentials.mjs && node --check lib/credits.mjs && node --check lib/endpoint.mjs && node --check lib/models.mjs && node --check lib/fetch_credits.mjs",
    "models": "node lib/fetch_credits.mjs models",
    "test": "node --test test/*.test.mjs",
    "credits": "node lib/fetch_credits.mjs credits",
    "login": "node lib/fetch_credits.mjs login",
    "credentials": "node lib/fetch_credits.mjs credentials"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "gcp-ai",
    "gcp",
    "google-cloud",
    "vertex",
    "vertex-ai",
    "gemini",
    "adc",
    "gcloud",
    "credits",
    "usage",
    "quota"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yaka88/google_vertex_plugin.git"
  },
  "magpie": {
    "icon": "data:image/png;base64,"
  }
}
